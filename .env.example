# Huckleberry API Credentials
HUCKLEBERRY_EMAIL=your-email@example.com
HUCKLEBERRY_PASSWORD=your-password-here

# Child Information
CHILD_NAME=Your Child Name

# Timezone (use standard timezone names like Europe/London, America/New_York, etc.)
TIMEZONE=Europe/London

# Webhook Security
WEBHOOK_SECRET=generate-a-random-secret-here-32-chars-minimum

# Server Configuration (optional, Railway sets this automatically)
PORT=5000
